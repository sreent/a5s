# Copy to test.tfvars, which git ignores, and fill in. Nothing here is a secret: Terraform
# makes the passwords, and people set the providers' keys in Key Vault after the first apply.
subscription_id   = "00000000-0000-0000-0000-000000000000"
environment       = "test"
location          = "uksouth"
image             = "ghcr.io/sreent/a5s@sha256:<the digest a release published>"
oidc_issuer       = "https://login.microsoftonline.com/<tenant id>/v2.0"
oidc_audience     = "<the web chat's client id>"
webchat_client_id = "<the web chat's client id>"
github_repository = "sreent/a5s"
budget_emails     = ["<who's told about spending>"]

# Teams, once the test tenant is ready: its id, and each agent's bot's app id there
# teams_tenant_id = "<the test tenant's id>"
# teams_bots      = { assistant = "<app id>", watcher = "<app id>" }

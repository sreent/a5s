// The facts a5s gives policy for every call. A request missing any of them is
// denied, and a policy pack that refers to anything else fails to load.

entity Instance = {
  status: String,
  level: Long,
  grants: Set<String>,
  model: String,
  serves: Set<String>,
};

entity Tool = {
  name: String,
  known: Bool,
  pinned: Bool,
  reads: Bool,
  writes: Bool,
  destructive: Bool,
  sends_outside: Bool,
  action: String,  // the type of action it takes, if it changes a part's data; else ""
};

entity Model = { name: String, approved: Bool, classes: Set<String> };

entity Person = { in_audience: Bool };

// A call's level is the lowest level the instance has in the parts of the records it's about.
// It's in scope if they're all in the instance's parts, and visible if everyone the run acts
// for may see them all.
type RunContext = {
  level: Long,
  read_outside: Bool,
  acts_for: Set<String>,
  in_scope: Bool,
  visible: Bool,
};

// A model call also says the class of the scenario's data, from the settings in force.
type ModelContext = {
  level: Long,
  read_outside: Bool,
  acts_for: Set<String>,
  data_class: String,
};

action call_tool appliesTo { principal: Instance, resource: Tool, context: RunContext };
action call_model appliesTo { principal: Instance, resource: Model, context: ModelContext };
action send_message appliesTo { principal: Instance, resource: Person, context: RunContext };
